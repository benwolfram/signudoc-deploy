+/**
+ * The zone deadlines are written in: DISPLAY_TIME_ZONE (an IANA name such as
+ * "America/Winnipeg"), or UTC when it is unset or not a zone.
+ */
+export function displayTimeZone(
+  env: Record<string, string | undefined> = process.env,
+): string {
+  const zone = env.DISPLAY_TIME_ZONE?.trim();
+
+  if (!zone) {
+    return "UTC";
+  }
+
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: zone });
+
+    return zone;
+  } catch {
+    return "UTC";
+  }
+}
+
