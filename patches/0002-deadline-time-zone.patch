 import {
   deadlineFromDays,
   EnvelopeDeadlinePassedError,
+  displayTimeZone,
   formatDeadline,
   isEnvelopeExpired,
   nextSignerLinkExpiresAt,
@@ -86,3 +87,26 @@ test("a deadline is written out in full, in UTC", () => {
   );
   assert.equal(buildDeadlineLine(null), null);
 });
+
+test("a deadline is written in the install's own zone, daylight time included", () => {
+  // 2027-01-15 08:00:00 UTC, in winter
+  assert.equal(
+    formatDeadline(1_800_000_000, "America/Winnipeg"),
+    "January 15, 2027 at 2:00 AM CST",
+  );
+  // 2026-12-06 is still winter; 2026-07-06 23:00 UTC is in daylight time
+  assert.equal(
+    formatDeadline(Date.UTC(2026, 6, 6, 23) / 1000, "America/Winnipeg"),
+    "July 6, 2026 at 6:00 PM CDT",
+  );
+});
+
+test("the display zone comes from DISPLAY_TIME_ZONE, and anything else is UTC", () => {
+  assert.equal(
+    displayTimeZone({ DISPLAY_TIME_ZONE: "America/Winnipeg" }),
+    "America/Winnipeg",
+  );
+  assert.equal(displayTimeZone({}), "UTC");
+  assert.equal(displayTimeZone({ DISPLAY_TIME_ZONE: " " }), "UTC");
+  assert.equal(displayTimeZone({ DISPLAY_TIME_ZONE: "Mars/Olympus" }), "UTC");
+});
