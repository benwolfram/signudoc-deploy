index 0000000..27c002e
--- /dev/null
+++ b/src/lib/services/email-layout.test.ts
@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { contrastRatio } from "../brand-color.ts";
+import {
+  buttonize,
+  EMAIL_TOKENS,
+  emailAccent,
+  renderEmailLayout,
+} from "./email-layout.ts";
+
+const AA = 4.5;
+
+test("every text color in the layout is readable on what it sits on", () => {
+  assert.ok(contrastRatio(EMAIL_TOKENS.text, EMAIL_TOKENS.card) >= AA);
+  assert.ok(contrastRatio(EMAIL_TOKENS.muted, EMAIL_TOKENS.page) >= AA);
+});
+
+test("white button text is readable on the accent, even for a pale brand color", () => {
+  for (const brand of [null, "#ffe14d", "#a0e8ff", "#5340d6"]) {
+    const accent = emailAccent(brand);
+
+    assert.ok(
+      contrastRatio(EMAIL_TOKENS.onAccent, accent) >= AA,
+      brand ?? "default",
+    );
+    // Outlined buttons put the accent on the card.
+    assert.ok(
+      contrastRatio(accent, EMAIL_TOKENS.card) >= AA,
+      brand ?? "default",
+    );
+  }
+});
+
+test("a paragraph that is only a link becomes a filled button", () => {
+  const html = buttonize(
+    '<p>Hi</p><p><a href="https://x.test/s/1">Review and sign</a></p>',
+    "#5340d6",
+  );
+
+  assert.match(html, /<p>Hi<\/p>/);
+  assert.match(
+    html,
+    /background:#5340d6;[^"]*"><a href="https:\/\/x\.test\/s\/1" style="[^"]*color:#ffffff;[^"]*">Review and sign<\/a>/,
+  );
+  assert.doesNotMatch(html, /<p><a/);
+});
+
+test("several links in one paragraph become a filled button, then outlined ones", () => {
+  const html = buttonize(
+    '<p><a href="/a">Download signed PDF</a><br /><a href="/b">Download certificate</a></p>',
+    "#5340d6",
+  );
+
+  assert.match(
+    html,
+    /background:#5340d6;[^>]*><a href="\/a" style="[^"]*color:#ffffff/,
+  );
+  assert.match(
+    html,
+    /background:#ffffff;[^>]*><a href="\/b" style="[^"]*color:#5340d6/,
+  );
+});
+
+test("a link inside a sentence stays a link", () => {
+  const html = buttonize(
+    '<p>Questions? Contact <a href="mailto:a@b.test">a@b.test</a>.</p>',
+    "#5340d6",
+  );
+
+  assert.doesNotMatch(html, /<table/);
+});
+
+test("the layout keeps the message, its escaping and the footer", () => {
+  const html = renderEmailLayout({
+    bodyHtml: "<p>Tom &amp; Jerry &lt;3</p>",
+    brandColor: null,
+    footerHtml: "<p>Sent using SignuDoc.</p>",
+    logoHtml: "",
+  });
+
+  assert.ok(html.startsWith("<!doctype html>"));
+  assert.match(html, />Tom &amp; Jerry &lt;3<\/p>/);
+  assert.match(html, />Sent using SignuDoc\.<\/p>/);
+  assert.match(html, /<meta name="color-scheme" content="light" \/>/);
+});
diff --git a/src/lib/services/email-layout.ts b/src/lib/services/email-layout.ts
new file mode 100644
index 0000000..f0b9e12
--- /dev/null
+++ b/src/lib/services/email-layout.ts
@@ -0,0 +1,112 @@
+import { buildBrandPalette, DEFAULT_BRAND_COLOR } from "../brand-color.ts";
+import { escapeHtml } from "../utils/html.ts";
+
+// The frame every email to a person is sent in: a white card on a pale
+// page, the logo above it, the footer below it, and each paragraph that is
+// only links drawn as buttons. Email programs ignore style sheets and most
+// modern CSS, so the layout is tables and every style is inline.
+
+/** Every color the layout uses. email-layout.test.ts checks their contrast. */
+export const EMAIL_TOKENS = {
+  page: "#f4f4f6",
+  card: "#ffffff",
+  border: "#e4e4e9",
+  text: "#1d1d22",
+  muted: "#5c5c66",
+  onAccent: "#ffffff",
+} as const;
+
+const FONT =
+  "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif";
+
+type EmailLayoutInput = {
+  bodyHtml: string;
+  brandColor: string | null;
+  footerHtml: string;
+  logoHtml: string;
+  title?: string;
+};
+
+// A paragraph made of links alone, one per line, as the messages write their
+// calls to action: <p><a href="…">…</a><br /><a href="…">…</a></p>.
+const LINK = String.raw`<a href="([^"]*)">([^<]*)</a>`;
+const LINK_PARAGRAPH = new RegExp(
+  String.raw`<p>(${LINK}(?:<br />${LINK})*)</p>`,
+  "g",
+);
+const LINK_GLOBAL = new RegExp(LINK, "g");
+
+/** The accent for buttons and links: white text on it is readable. */
+export function emailAccent(brandColor: string | null): string {
+  return (buildBrandPalette(brandColor ?? DEFAULT_BRAND_COLOR) ??
+    buildBrandPalette(DEFAULT_BRAND_COLOR))!.accent;
+}
+
+function button(href: string, label: string, accent: string, primary: boolean) {
+  const fill = primary ? accent : EMAIL_TOKENS.card;
+  const ink = primary ? EMAIL_TOKENS.onAccent : accent;
+
+  // 14px padding + 20px line height = 48px tall, above the 44px target.
+  return [
+    '<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 12px;">',
+    `<tr><td style="border-radius:8px;background:${fill};border:1px solid ${accent};">`,
+    `<a href="${href}" style="display:inline-block;padding:14px 24px;font-family:${FONT};font-size:16px;line-height:20px;font-weight:600;color:${ink};text-decoration:none;border-radius:8px;">${label}</a>`,
+    "</td></tr></table>",
+  ].join("");
+}
+
+/** Link-only paragraphs become buttons: the first filled, the rest outlined. */
+export function buttonize(html: string, accent: string): string {
+  return html.replace(LINK_PARAGRAPH, (paragraph) => {
+    const links = [...paragraph.matchAll(LINK_GLOBAL)];
+    const buttons = links
+      .map(([, href, label], index) =>
+        button(href!, label!, accent, index === 0),
+      )
+      .join("");
+
+    return `<div style="margin:24px 0 8px;">${buttons}</div>`;
+  });
+}
+
+function styleText(html: string, accent: string, color: string, size: number) {
+  return html
+    .replaceAll(
+      "<p>",
+      `<p style="margin:0 0 16px;font-family:${FONT};font-size:${size}px;line-height:1.6;color:${color};">`,
+    )
+    .replace(/<a href="([^"]*)">/g, `<a href="$1" style="color:${accent};">`);
+}
+
+export function renderEmailLayout(input: EmailLayoutInput): string {
+  const accent = emailAccent(input.brandColor);
+  const body = styleText(
+    buttonize(input.bodyHtml, accent),
+    accent,
+    EMAIL_TOKENS.text,
+    16,
+  );
+  const footer = styleText(input.footerHtml, accent, EMAIL_TOKENS.muted, 13);
+
+  return [
+    '<!doctype html><html lang="en"><head><meta charset="utf-8" />',
+    '<meta name="viewport" content="width=device-width,initial-scale=1" />',
+    '<meta name="color-scheme" content="light" /><meta name="supported-color-schemes" content="light" />',
+    "</head>",
+    `<body style="margin:0;padding:0;background:${EMAIL_TOKENS.page};">`,
+    `<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:${EMAIL_TOKENS.page};">`,
+    '<tr><td align="center" style="padding:32px 16px;">',
+    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">',
+    input.logoHtml
+      ? `<tr><td style="padding:0 8px 20px;">${input.logoHtml}</td></tr>`
+      : "",
+    `<tr><td style="background:${EMAIL_TOKENS.card};border:1px solid ${EMAIL_TOKENS.border};border-radius:12px;padding:32px;">`,
+    input.title
+      ? `<h1 style="margin:0 0 20px;font-family:${FONT};font-size:24px;line-height:1.3;font-weight:700;color:${EMAIL_TOKENS.text};">${escapeHtml(input.title)}</h1>`
+      : "",
+    body,
+    "</td></tr>",
+    footer ? `<tr><td style="padding:20px 8px 0;">${footer}</td></tr>` : "",
+    "</table></td></tr></table></body></html>",
+  ].join("");
+}
