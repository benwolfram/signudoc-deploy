new file mode 100644
index 0000000..b4df677
--- /dev/null
+++ b/src/lib/display-time-zone.test.ts
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  displayTimeZone,
+  formatEvidenceTimestamp,
+} from "./display-time-zone.ts";
+
+test("the display zone comes from DISPLAY_TIME_ZONE, and anything else is UTC", () => {
+  assert.equal(
+    displayTimeZone({ DISPLAY_TIME_ZONE: "America/Winnipeg" }),
+    "America/Winnipeg",
+  );
+  assert.equal(displayTimeZone({}), "UTC");
+  assert.equal(displayTimeZone({ DISPLAY_TIME_ZONE: " " }), "UTC");
+  assert.equal(displayTimeZone({ DISPLAY_TIME_ZONE: "Mars/Olympus" }), "UTC");
+});
+
+test("evidence times are sortable, 24-hour, and name their zone", () => {
+  // 2026-12-06 23:00:05 UTC
+  const timestamp = Date.UTC(2026, 11, 6, 23, 0, 5) / 1000;
+
+  assert.equal(
+    formatEvidenceTimestamp(timestamp, "America/Winnipeg"),
+    "2026-12-06 17:00:05 CST",
+  );
+  assert.equal(
+    formatEvidenceTimestamp(timestamp, "UTC"),
+    "2026-12-06 23:00:05 UTC",
+  );
+  // Just after midnight stays 00, not 24.
+  assert.equal(
+    formatEvidenceTimestamp(
+      Date.UTC(2026, 6, 7, 5, 0, 0) / 1000,
+      "America/Winnipeg",
+    ),
+    "2026-07-07 00:00:00 CDT",
+  );
+});
diff --git a/src/lib/display-time-zone.ts b/src/lib/display-time-zone.ts
new file mode 100644
index 0000000..3ed23c3
--- /dev/null
+++ b/src/lib/display-time-zone.ts
@@ -0,0 +1,49 @@
+/**
+ * The zone every date and time people see is written in: DISPLAY_TIME_ZONE
+ * (an IANA name such as "America/Winnipeg"), or UTC when it is unset or not
+ * a zone. Server-only: pages hand it to browser code as data.
+ */
+export function displayTimeZone(
+  env: Record<string, string | undefined> = process.env,
+): string {
+  const zone = env.DISPLAY_TIME_ZONE?.trim();
+
+  if (!zone) {
+    return "UTC";
+  }
+
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: zone });
+
+    return zone;
+  } catch {
+    return "UTC";
+  }
+}
+
+/**
+ * "2026-12-06 17:00:00 CST": the evidence format, sortable and with the zone
+ * named, so a time on the certificate is never ambiguous.
+ */
+export function formatEvidenceTimestamp(
+  unixTimestamp: number,
+  timeZone: string = displayTimeZone(),
+): string {
+  const parts = Object.fromEntries(
+    new Intl.DateTimeFormat("en-US", {
+      day: "2-digit",
+      hour: "2-digit",
+      hourCycle: "h23",
+      minute: "2-digit",
+      month: "2-digit",
+      second: "2-digit",
+      timeZone,
+      timeZoneName: "short",
+      year: "numeric",
+    })
+      .formatToParts(new Date(unixTimestamp * 1000))
+      .map((part) => [part.type, part.value]),
+  );
+
+  return `${parts.year}-${parts.month}-${parts.day} ${parts.hour}:${parts.minute}:${parts.second} ${parts.timeZoneName}`;
+}
