# Paste into /opt/docker/tailnet-proxy/Caddyfile in place of the DocuSeal
# sign-admin block. Full admin UI; public sign. goes through the edge tunnel
# allowlist. Caddy sets X-Forwarded-For to the tailnet client's address.
sign-admin.brioche.studio {
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:5200
}
