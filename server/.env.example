# machine paths
DOCKER_ROOT=/opt/docker
TZ=America/Winnipeg
# Every date and time people see is written in this zone (patch 0002).
DISPLAY_TIME_ZONE=America/Winnipeg

# Postgres (internal network only). openssl rand -hex 24
POSTGRES_PASSWORD=

# Public host: every emailed link is built from it.
APP_URL=https://sign.brioche.studio
# Admin host (tailnet only): sign-in and the dashboard only work here.
BETTER_AUTH_URL=https://sign-admin.brioche.studio

# Encrypts the seal key and signs sessions. openssl rand -hex 32
# DO NOT LOSE OR CHANGE: a new one makes a new seal key.
BETTER_AUTH_SECRET=

# Email through Resend (same account as DocuSeal).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# Trusted outside time on every seal (PAdES B-T, then B-LTA). Free.
SEAL_TIMESTAMP_URL=http://timestamp.digicert.com

# Closes /api/internal/{retention,webhooks} to callers without it; the host
# timer sends it. openssl rand -hex 32
RETENTION_JOB_SECRET=
